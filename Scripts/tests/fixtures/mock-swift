#!/usr/bin/env bash
set -euo pipefail

printf '%s\n' '---' >> "$MOCK_SWIFT_LOG"
printf '%s\n' "$@" >> "$MOCK_SWIFT_LOG"

if [ "${1:-}" = "--version" ]; then
    echo "Apple Swift version 6.0 (mock)"
    exit 0
fi

if [ "${1:-}" != "build" ] || [ "${2:-}" != "-c" ] || [ "${3:-}" != "release" ] || \
   [ "${4:-}" != "--package-path" ] || [ "${5:-}" != "$MOCK_REPO" ]; then
    echo "unexpected swift invocation" >&2
    exit 1
fi

MOCK_PRODUCT_DIR="$MOCK_REPO/.build/custom-release"
if [ "$#" -eq 6 ] && [ "${6:-}" = "--show-bin-path" ]; then
    mkdir -p "$MOCK_PRODUCT_DIR"
    printf '%s\n' "$MOCK_PRODUCT_DIR"
    exit 0
fi

if [ "$#" -ne 7 ] || [ "${6:-}" != "--product" ] || [ "${7:-}" != "attention-thief-catcher" ]; then
    echo "unexpected swift build invocation" >&2
    exit 1
fi

mkdir -p "$MOCK_PRODUCT_DIR"
printf '%s\n' 'mock SwiftPM release product' > "$MOCK_PRODUCT_DIR/attention-thief-catcher"
chmod 755 "$MOCK_PRODUCT_DIR/attention-thief-catcher"
